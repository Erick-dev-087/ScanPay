<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="12dp"
    app:cardBackgroundColor="@color/ui_surface_low" app:cardCornerRadius="16dp" app:cardElevation="0dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal"
        android:gravity="center_vertical" android:padding="16dp" android:minHeight="100dp">
        <ImageView android:layout_width="40dp" android:layout_height="40dp" android:src="@drawable/ic_store"
            android:background="@drawable/bg_transaction_icon" android:padding="10dp" app:tint="@color/ui_secondary" android:contentDescription="@null" />
        <TextView android:id="@+id/tv_merchant_name" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:layout_marginStart="12dp" android:layout_marginEnd="12dp" android:textColor="@color/ui_on_surface" android:textSize="14sp"
            android:lineSpacingExtra="4dp" android:maxLines="5" android:ellipsize="end" />
        <TextView android:id="@+id/tv_amount" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textColor="@color/ui_secondary" android:textSize="16sp" android:textStyle="bold" android:maxWidth="150dp" />
    </LinearLayout>
</androidx.cardview.widget.CardView>

