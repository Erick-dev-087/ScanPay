<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/ui_surface" android:fillViewport="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="24dp">
        <com.google.android.material.button.MaterialButton android:id="@+id/btn_back" style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content" android:layout_height="48dp" android:text="Back" android:textColor="@color/ui_secondary" />
        <TextView android:id="@+id/tv_title" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="Spending insights" android:textSize="28sp" android:textStyle="bold" android:textColor="@color/ui_on_surface" />
        <com.google.android.material.button.MaterialButtonToggleGroup android:id="@+id/period_group" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginTop="20dp" app:singleSelection="true" app:selectionRequired="true" app:checkedButton="@id/btn_month">
            <com.google.android.material.button.MaterialButton android:id="@+id/btn_week" style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp" android:layout_height="56dp" android:layout_weight="1" android:text="7 days" android:textColor="@color/ui_secondary" />
            <com.google.android.material.button.MaterialButton android:id="@+id/btn_month" style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp" android:layout_height="56dp" android:layout_weight="1" android:text="30 days" android:textColor="@color/ui_secondary" />
            <com.google.android.material.button.MaterialButton android:id="@+id/btn_quarter" style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp" android:layout_height="56dp" android:layout_weight="1" android:text="90 days" android:textColor="@color/ui_secondary" />
        </com.google.android.material.button.MaterialButtonToggleGroup>
        <TextView android:id="@+id/tv_total" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="24dp"
            android:text="—" android:textSize="36sp" android:textStyle="bold" android:textColor="@color/ui_secondary" />
        <TextView android:id="@+id/tv_summary" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp"
            android:text="Loading confirmed payments…" android:textColor="@color/ui_on_surface_variant" />
        <com.github.mikephil.charting.charts.LineChart android:id="@+id/line_chart" android:layout_width="match_parent" android:layout_height="280dp" android:layout_marginTop="24dp" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="20dp"
            android:text="Payment categories" android:textSize="20sp" android:textStyle="bold" android:textColor="@color/ui_on_surface" />
        <TextView android:id="@+id/tv_categories" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="16dp" android:lineSpacingExtra="12dp" android:textColor="@color/ui_on_surface" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>

