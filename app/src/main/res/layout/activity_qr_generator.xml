<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ui_surface_lowest"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/btn_back"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:contentDescription="@string/cd_back_button"
                android:src="@drawable/ic_back"
                app:tint="@color/ui_on_surface" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_weight="1"
                android:fontFamily="sans-serif-medium"
                android:text="Generate Payment QR"
                android:textColor="@color/ui_on_surface"
                android:textSize="20sp" />

        </LinearLayout>

        <!-- Configuration Card -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_saved_qr"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="Open saved payment QRs"
            android:textColor="@color/ui_secondary" />
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            app:cardBackgroundColor="@color/ui_surface_low"
            app:cardCornerRadius="20dp"
            app:cardElevation="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="18dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:text="QR Type &amp; Method"
                    android:textColor="@color/ui_primary"
                    android:textSize="14sp" />

                <!-- Type Selector (Static vs Dynamic) -->
                <RadioGroup
                    android:id="@+id/rg_qr_type"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="horizontal">

                    <RadioButton
                        android:id="@+id/rb_static"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:checked="true"
                        android:text="Static (Flexible Amount)"
                        android:textColor="@color/ui_on_surface"
                        android:textSize="13sp" />

                    <RadioButton
                        android:id="@+id/rb_dynamic"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Dynamic (Fixed Amount)"
                        android:textColor="@color/ui_on_surface"
                        android:textSize="13sp" />

                </RadioGroup>

                <!-- Amount Input -->
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/til_amount"
                    style="@style/TextInputStyle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:visibility="gone"
                    app:boxBackgroundColor="@color/ui_surface_variant"
                    app:hintTextColor="@color/ui_on_surface_variant"
                    app:prefixText="KES "
                    app:prefixTextColor="@color/ui_primary">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/et_amount"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Amount to Pay"
                        android:inputType="numberDecimal"
                        android:textColor="@color/ui_on_surface" />

                </com.google.android.material.textfield.TextInputLayout>

                <!-- Reference / Bill Number -->
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/til_reference"
                    style="@style/TextInputStyle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    app:boxBackgroundColor="@color/ui_surface_variant"
                    app:hintTextColor="@color/ui_on_surface_variant">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/et_reference"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Reference / Account (Optional)"
                        android:inputType="textCapCharacters"
                        android:textColor="@color/ui_on_surface" />

                </com.google.android.material.textfield.TextInputLayout>

                <!-- Generate CTA -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_generate"
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    android:layout_marginTop="20dp"
                    android:background="@drawable/bg_dashboard_primary_button"
                    android:fontFamily="sans-serif-medium"
                    android:letterSpacing="0.06"
                    android:text="Generate QR Code"
                    android:textAllCaps="true"
                    android:textColor="@color/ui_on_primary"
                    android:textSize="14sp"
                    app:icon="@drawable/ic_qr_code"
                    app:iconGravity="textStart"
                    app:iconTint="@color/ui_on_primary" />

            </LinearLayout>

        </androidx.cardview.widget.CardView>

        <!-- QR Display Preview Card -->
        <androidx.cardview.widget.CardView
            android:id="@+id/card_qr_preview"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:visibility="gone"
            app:cardBackgroundColor="@color/ui_surface_low"
            app:cardCornerRadius="24dp"
            app:cardElevation="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:padding="24dp">

                <TextView
                    android:id="@+id/tv_preview_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:text="ScanPay Merchant QR"
                    android:textColor="@color/ui_on_surface"
                    android:textSize="18sp" />

                <TextView
                    android:id="@+id/tv_preview_shortcode"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Till Number: 123456"
                    android:textColor="@color/ui_primary"
                    android:textSize="14sp" />

                <!-- White Container for High-Contrast QR Scanning -->
                <androidx.cardview.widget.CardView
                    android:layout_width="240dp"
                    android:layout_height="240dp"
                    android:layout_marginTop="20dp"
                    app:cardBackgroundColor="#FFFFFF"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="0dp">

                    <ImageView
                        android:id="@+id/iv_generated_qr"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:contentDescription="@string/cd_qr_code"
                        android:padding="16dp"
                        android:scaleType="fitCenter" />

                </androidx.cardview.widget.CardView>

                <TextView
                    android:id="@+id/tv_preview_amount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:fontFamily="sans-serif-medium"
                    android:text="Scan to Pay Any Amount"
                    android:textColor="@color/ui_on_surface"
                    android:textSize="15sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_share_qr"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_marginEnd="8dp"
                        android:layout_weight="1"
                        android:backgroundTint="@color/ui_surface_highest"
                        android:text="Share"
                        android:textColor="@color/ui_on_surface"
                        app:cornerRadius="12dp"
                        app:icon="@drawable/ic_more"
                        app:iconTint="@color/ui_on_surface" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_save_qr"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:backgroundTint="@color/ui_primary"
                        android:text="Save"
                        android:textColor="@color/ui_on_primary"
                        app:cornerRadius="12dp"
                        app:icon="@drawable/ic_check"
                        app:iconTint="@color/ui_on_primary" />

                </LinearLayout>

            </LinearLayout>

        </androidx.cardview.widget.CardView>

    </LinearLayout>

</androidx.core.widget.NestedScrollView>

