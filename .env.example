# AppConfig also supports the existing JSON .env; process environment takes precedence.
ASTRA_TOKEN=
ASTRA_DATABASE_ID=
ASTRA_KEYSPACE=default_keyspace
# Optional: use a downloaded secure connect bundle instead of obtaining one through Astra DevOps.
ASTRA_SECURE_CONNECT_BUNDLE=
ASTRA_AUTO_MIGRATE=true
JWT_SECRET_KEY=
PORT=5000

# Real STK requests are the default. Set mock explicitly for a local test; no real prompt is sent.
PAYMENT_MODE=daraja
DARAJA_BASE_URL=https://sandbox.safaricom.co.ke
DARAJA_CONSUMER_KEY=
DARAJA_CONSUMER_SECRET=
DARAJA_SHORTCODE=
DARAJA_PASSKEY=
DARAJA_APPROVED_SHORTCODES=
# Use a URL routed to THIS backend, and include ?secret=<PAYMENT_CALLBACK_SECRET>
# when Safaricom cannot supply X-Callback-Secret. Avoid logging query strings at the proxy.
DARAJA_CALLBACK_URL=
PAYMENT_CALLBACK_SECRET=

